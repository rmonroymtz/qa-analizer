# qa-analyzer environment variables.
# Copy to .env (git-ignored) for local runs: cp env.example .env
# In Bitbucket, define them as deployment variables per environment and mark
# the secrets as "Secured".

# --- Target site -------------------------------------------------------------
# Base URL of the deployed environment (required), set per deployment environment
# (e.g. https://staging.chupaprecios.com.mx or https://chupaprecios.com.mx).
# Ticket URLs on the same registrable domain (chupaprecios.com.mx) are inspected
# on this environment: their path and query are applied to this base URL.
TARGET_BASE_URL=https://staging.example.com
# staging | production. Leave empty in Bitbucket Pipelines: Bitbucket sets
# BITBUCKET_DEPLOYMENT_ENVIRONMENT automatically, and a QA_ENV (or --env) value
# that conflicts with it fails the run (exit 2). Set it only for local runs.
QA_ENV=

# --- Jira --------------------------------------------------------------------
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=qa-bot@example.com
# Secret. Create it at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# Optional custom field id holding the acceptance criteria (e.g. customfield_10042).
# When empty, the criteria are read from the ticket description.
JIRA_AC_FIELD=

# --- Claude ------------------------------------------------------------------
# Secret. Required in CI.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5).
QA_MODEL=

# --- Ticket key resolution ---------------------------------------------------
# Explicit ticket key. An invalid value is a configuration error (exit 2).
QA_TICKET=
# Optional comma-separated project keys allowed (e.g. PROJ,SHOP).
QA_JIRA_PROJECTS=
# Optional commit message to search for the key (default: HEAD commit message).
QA_COMMIT_MESSAGE=

# --- Readiness after deploy --------------------------------------------------
# Optional health/version URL that reports the deployed commit SHA.
QA_READY_URL=
# Readiness timeout in milliseconds (default: 300000).
QA_READY_TIMEOUT_MS=300000

# --- Page load wait ------------------------------------------------------------
# Before each snapshot and after each plan goto, wait until no request to the
# target's own site (same registrable domain) has been in flight for
# QA_SETTLE_QUIET_MS, at most QA_SETTLE_TIMEOUT_MS. Third parties are ignored.
QA_SETTLE_QUIET_MS=1000
QA_SETTLE_TIMEOUT_MS=30000

# --- Traces (opt-in) ----------------------------------------------------------
# true records a Playwright trace per executed criterion in qa-report/traces/.
# Refused (exit 2) in production and with QA_AUTH_MODE=form: traces hold
# cookies and response bodies. Same as --trace.
QA_TRACE=false

# --- Login (only when the site requires authentication) ---------------------
# none (default) | form
QA_AUTH_MODE=none
# Secrets: use a dedicated QA account, with minimal permissions in production.
TEST_USER=
TEST_PASSWORD=
QA_LOGIN_PATH=/login
QA_LOGIN_USER_SELECTOR=input[name=email]
QA_LOGIN_PASSWORD_SELECTOR=input[name=password]
QA_LOGIN_SUBMIT_SELECTOR=button[type=submit]
# Optional regex the URL must match after a successful login.
QA_LOGIN_SUCCESS_URL=
# Optional comma-separated path globs (or ^regex) the login form may post to in
# production, besides QA_LOGIN_PATH. Allowed during the login only.
QA_LOGIN_ALLOW=

# --- Production read-only mode ----------------------------------------------
# Optional comma-separated path globs (or ^regex) on the target host allowed to mutate
# during inspection and tests (the login path is NOT included automatically).
QA_READONLY_ALLOW=
# Optional comma-separated hostnames allowed to receive mutations (e.g. analytics).
QA_READONLY_ALLOW_HOSTS=

# --- Set automatically by Bitbucket Pipelines (do not define manually) -------
# BITBUCKET_BRANCH, BITBUCKET_COMMIT, BITBUCKET_DEPLOYMENT_ENVIRONMENT
